<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Tema dell'app dopo la splash (BridgeActivity lo imposta da sé). Fondo scuro: niente lampo bianco prima che la pagina compaia. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/spindro_bg</item>
        <item name="android:statusBarColor">@color/spindro_bg</item>
        <item name="android:navigationBarColor">@color/spindro_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Splash: Android 12+ usa icona e colore qui sotto; le versioni precedenti usano il drawable "splash" (fondo scuro + ruota) -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/spindro_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
