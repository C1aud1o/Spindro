<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 e precedenti (fullBackupContent): stessa scelta, nessun backup cloud dei dati dell'app
     (lo storico delle uscite è personale). Su queste versioni non esiste un trasferimento separato. -->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
