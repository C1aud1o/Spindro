{
  "id": "/app/",
  "name": "Spindro: Smart Trainer Cycling",
  "short_name": "Spindro",
  "description": "Free, open-source indoor cycling for smart trainers: structured workouts, virtual gears, games and FIT export.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0f0f0d",
  "theme_color": "#0f0e0c",
  "categories": ["sports", "health", "fitness"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Workouts", "url": "./?open=workouts", "icons": [{ "src": "icons/shortcut-workouts.png", "sizes": "96x96", "type": "image/png" }] },
    { "name": "Games", "url": "./?open=games", "icons": [{ "src": "icons/shortcut-workouts.png", "sizes": "96x96", "type": "image/png" }] }
  ]
}
